{
  "manifest_version": 3,
  "name": "Web Clipper Pro",
  "version": "1.0.0",
  "description": "A browser extension to clip web content, organize materials, and create simple video sequences.",
  "permissions": ["activeTab", "storage", "scripting", "contextMenus"],
  "action": {
    "default_title": "Clip Content",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
